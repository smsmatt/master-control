# Master Control secrets — copy to master-control.env on a1 (gitignored). From `pass`.
# ntfy bearer for reading universal-exports / ghostmode-alerts:
NTFY_TOKEN=
# GreyNoise community key (pass: greynoise/api-key). Private IPs are never sent off-box.
GREYNOISE_API_KEY=
# MTPLX API key for the phrasing model (pass: sanmarcsoft/mtplx/api-key). MTPLX
# returns 401 without it, and phrase() answers a 401 with the deterministic
# template, so an empty value here degrades every spoken line silently.
MC_LLM_KEY=
# Bearer for the inbound MCP listener (pass: sanmarcsoft/master-control/listener-token).
# The Code:Talker bridge sends this as `Authorization: Bearer <token>` on /mcp.
# Leave it empty and the listener refuses to open at all: an unauthenticated
# directive endpoint on the LAN is worse than no endpoint. /health stays open
# either way, because the bridge's health probe sends no credentials.
MC_LISTEN_TOKEN=
